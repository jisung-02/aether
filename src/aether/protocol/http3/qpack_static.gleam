//// QPACK static table (RFC 9204 Appendix A).
////
//// The 99-entry table shared by every QPACK encoder/decoder. Generated
//// from the RFC 9204 Appendix A table text (do not hand-edit entries;
//// regenerate from the RFC if this ever needs to change).

/// The result of looking up a name/value pair against the static table.
///
pub type Match {
  /// Both the name and the value matched a static entry.
  FullMatch(index: Int)
  /// Only the name matched a static entry (the first such entry).
  NameMatch(index: Int)
  /// Neither the name nor the value matched any static entry.
  NoMatch
}

/// Looks up the (name, value) pair at a static table index.
///
/// Returns `Error(Nil)` if `index` is outside the static table (0-98).
///
pub fn entry(index: Int) -> Result(#(String, String), Nil) {
