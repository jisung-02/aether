/// Finds the best static table match for a (name, value) pair.
///
/// Returns `FullMatch` if some entry has both the same name and value,
/// else `NameMatch` with the first entry whose name matches, else
/// `NoMatch`.
///
pub fn find(name: String, value: String) -> Match {
  case find_full(name, value) {
    Ok(index) -> FullMatch(index)
    Error(Nil) ->
      case find_name(name) {
        Ok(index) -> NameMatch(index)
        Error(Nil) -> NoMatch
      }
  }
}

